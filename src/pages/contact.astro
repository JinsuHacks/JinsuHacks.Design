---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import ContactForm from '@/components/contact/ContactForm.astro';
import contactData from '@/data/contact.json';
---

<BaseLayout title="Contact" description="Get in touch with JinsuHacks.Design. Let's discuss your project and how we can help you achieve your goals.">
  <slot name="header">
    <Header />
  </slot>

  <!-- Hero -->
  <section class="hero" style="min-height: 50vh; min-height: 50dvh;">
    <div class="mesh-gradient" aria-hidden="true"></div>
    <div class="metro-grid metro-grid--animated" aria-hidden="true"></div>
    <div class="hero__content">
      <div class="hero__badge" data-animate="fade-in-up">
        <span aria-hidden="true">📩</span>
        <span>What are you working through?</span>
      </div>
      <h1 class="hero__title" data-animate="fade-in-up" style="animation-delay: 150ms;">
        Tell us what <span class="gradient-text">you’re trying to make</span>.
      </h1>
      <p class="hero__description" data-animate="fade-in-up" style="animation-delay: 300ms; max-width: 700px;">
        Share the problem, the people it affects and what you’ve tried so far. We’ll reply within 24 hours to talk through a sensible next step.
      </p>
    </div>
  </section>

  <!-- Contact Form + Info -->
  <section class="section" aria-labelledby="contact-title">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Contact Info -->
        <div class="lg:col-span-1" data-animate="fade-in-up">
          <h2 id="contact-title" style="font-size: var(--text-3xl); font-weight: var(--font-extrabold); margin-bottom: var(--space-6);">
            Let's <span class="gradient-text">connect</span>
          </h2>
          <p style="color: var(--color-text-muted); margin-bottom: var(--space-8);">
            Based in Alpharetta, Georgia, and working with teams wherever the project takes us. Tell us what you’re making and who needs to be involved.
          </p>

          <div class="glass glass--strong" style="padding: var(--space-6); margin-bottom: var(--space-6);">
            <h3 style="font-size: var(--text-sm); font-weight: var(--font-semibold); text-transform: uppercase; letter-spacing: var(--tracking-wider); color: var(--color-text-muted); margin-bottom: var(--space-4);">Email</h3>
            <a href={`mailto:${contactData.email}`} style="font-size: var(--text-lg); font-weight: var(--font-medium); color: var(--color-text); text-decoration: none; display: block; transition: color 150ms ease-out;" onmouseover="this.style.color='var(--color-primary)'" onmouseout="this.style.color=''">
              {contactData.email}
            </a>
          </div>

          <div class="glass glass--strong" style="padding: var(--space-6); margin-bottom: var(--space-6);">
            <h3 style="font-size: var(--text-sm); font-weight: var(--font-semibold); text-transform: uppercase; letter-spacing: var(--tracking-wider); color: var(--color-text-muted); margin-bottom: var(--space-4);">Phone</h3>
            <a href={`tel:${contactData.phoneHref}`} style="font-size: var(--text-lg); font-weight: var(--font-medium); color: var(--color-text); text-decoration: none; display: block; transition: color 150ms ease-out;" onmouseover="this.style.color='var(--color-primary)'" onmouseout="this.style.color=''">
              {contactData.phoneDisplay}
            </a>
          </div>

          <div class="glass glass--strong" style="padding: var(--space-6); margin-bottom: var(--space-6);">
            <h3 style="font-size: var(--text-sm); font-weight: var(--font-semibold); text-transform: uppercase; letter-spacing: var(--tracking-wider); color: var(--color-text-muted); margin-bottom: var(--space-4);">Studio</h3>
            <address style="font-style: normal; color: var(--color-text-muted); line-height: var(--leading-relaxed);">
              {contactData.location}
            </address>
          </div>

          <div class="glass glass--strong" style="padding: var(--space-6);">
            <h3 style="font-size: var(--text-sm); font-weight: var(--font-semibold); text-transform: uppercase; letter-spacing: var(--tracking-wider); color: var(--color-text-muted); margin-bottom: var(--space-4);">Follow Us</h3>
            <div class="footer-social" style="gap: var(--space-3);">
              <a href="https://twitter.com/jinsuhacks" class="footer-social-link" aria-label="Twitter" target="_blank" rel="noopener noreferrer">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-6.706 11.55 2.832 8.4 2.848-7.258 7.84-4.204-7.388-4.186L24 2.25h-3.392l-4.85 5.57-4.424-2.485-4.328 6.104h-2.833l2.793-7.494-6.623-2.25h-2.979l4.566 6.488-6.042 7.227H.41l7.595-10.064L0 2.25h3.353l4.277 5.222 6.476-5.872H17.2l-4.72 5.208L20.033 24H24l-5.788-8.621Z"/></svg>
              </a>
              <a href="https://linkedin.com/company/jinsuhacks" class="footer-social-link" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
              <a href="https://dribbble.com/jinsuhacks" class="footer-social-link" aria-label="Dribbble" target="_blank" rel="noopener noreferrer">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.094 17.067c0 2.594-1.771 4.184-5.094 4.184-3.324 0-5.094-1.59-5.094-4.184 0-2.595 1.771-4.185 5.094-4.185 3.323 0 5.094 1.59 5.094 4.185zm-8.386-.001c0 2.332 1.569 3.766 4.49 3.766 2.92 0 4.491-1.433 4.491-3.766 0-2.333-1.571-3.767-4.491-3.767-2.921 0-4.49-1.433-4.49-3.767z"/></svg>
              </a>
              <a href="https://github.com/jinsuhacks" class="footer-social-link" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Form -->
        <div class="lg:col-span-2" data-animate="fade-in-up" style="animation-delay: 150ms;">
          <div class="glass glass--gradient-border" style="padding: var(--space-8);">
            <h3 style="font-size: var(--text-2xl); font-weight: var(--font-bold); margin-bottom: var(--space-2);">Tell us about your project</h3>
            <p style="color: var(--color-text-muted); margin-bottom: var(--space-8);">A few specifics help: what you’re making, where you’re stuck, and any timing or technical constraints.</p>
            <ContactForm />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section bg-bg-alt" aria-labelledby="faq-title">
    <div class="container">
      <header class="section-header" data-animate="fade-in-up">
        <span class="section-header__badge">Common Questions</span>
        <h2 id="faq-title" class="section-header__title">
          Quick <span class="gradient-text">answers</span>
        </h2>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" style="max-width: 900px; margin: 0 auto;">
        {[
          {
            q: "What's your typical project timeline?",
            a: "Most projects range from 4-16 weeks depending on scope. Brand identity: 4-6 weeks. Digital products: 8-16 weeks. Websites: 6-12 weeks. We'll give you a detailed timeline during our initial consultation."
          },
          {
            q: "How do you price your work?",
            a: "We use value-based pricing tied to project outcomes, not hourly rates. After understanding your goals, we provide a fixed-price proposal with clear deliverables and milestones. No surprise invoices."
          },
          {
            q: "Do you work with early-stage startups?",
            a: "Absolutely. We love working with founding teams. We offer startup-friendly terms and can help with investor-ready design assets, MVP design, and pitch deck design."
          },
          {
            q: "What's your design process like?",
            a: "We start by understanding the audience, goals and constraints. Then we map the important flows, explore and test directions, refine the design, and review it in implementation. The exact steps depend on the scope."
          },
          {
            q: "Do you provide ongoing support?",
            a: "Ongoing work can cover product improvements, new features or design-system maintenance. The cadence and scope are agreed up front; we don't offer round-the-clock support."
          },
          {
            q: "Where are you located?",
            a: "JinsuHacks is based in Alpharetta, Georgia. We can work remotely with teams in other locations and plan reviews around the people involved."
          }
        ].map((faq, index) => (
          <details class="glass glass--strong" style="padding: var(--space-6);" data-animate="fade-in-up" style={`animation-delay: ${index * 100}ms`}>
            <summary style="font-weight: var(--font-semibold); cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between;">
              {faq.q}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="transition: transform 200ms ease-out;">
                <path d="M6 9l6 6 6-6"/>
              </svg>
            </summary>
            <div style="margin-top: var(--space-4); color: var(--color-text-muted); line-height: var(--leading-relaxed);">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <slot name="footer">
    <Footer />
  </slot>
</BaseLayout>