---
import servicesData from '@/data/services.json';
import GridBlock from '@/components/ui/GridBlock.astro';
import PrismButton from '@/components/ui/PrismButton.astro';
---

<section class="section" aria-labelledby="services-preview-title">
  <div class="container">
    <header class="section-header" data-animate="fade-in-up">
      <span class="section-header__badge">What We Do</span>
      <h2 id="services-preview-title" class="section-header__title">
        Design that holds up <span class="gradient-text">in the real world</span>
      </h2>
      <p class="section-header__description">
        From positioning and visual identity to interface states and front-end details, each part is designed to work together.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {servicesData.services.map(service => (
        <GridBlock
          title={service.title}
          description={service.description}
          label={service.icon}
          aspect="landscape"
          color={service.color}
          image={service.image}
        />
      ))}
    </div>

    <aside class="metro-feature-card" aria-labelledby="metro-feature-title" data-animate="fade-in-up">
      <div class="metro-feature-card__inner">
        <div class="metro-feature-card__copy">
          <span class="metro-feature-card__eyebrow">Good work starts with good questions</span>
          <h3 id="metro-feature-title">Make the system clear. <span>Make the details count.</span></h3>
          <p>We connect brand decisions to product behavior, so the finished work feels coherent—not assembled from disconnected parts.</p>
        </div>
        <ul class="metro-feature-card__list">
          <li><span class="metro-feature-card__check" aria-hidden="true">✓</span> Positioning, identity and art direction</li>
          <li><span class="metro-feature-card__check" aria-hidden="true">✓</span> User flows, interface states and prototypes</li>
          <li><span class="metro-feature-card__check" aria-hidden="true">✓</span> Tokens, components and usage rules</li>
          <li><span class="metro-feature-card__check" aria-hidden="true">✓</span> Responsive implementation and QA</li>
        </ul>
        <a href="/contact" class="button button--primary metro-feature-card__button">
          Book a discovery call
          <svg class="button__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </aside>

    <div class="text-center mt-10" data-animate="fade-in-up" style="animation-delay: 300ms;">
      <PrismButton href="/services" label="Explore services" count="06" ariaLabel="Explore all six services" />
    </div>
  </div>
</section>