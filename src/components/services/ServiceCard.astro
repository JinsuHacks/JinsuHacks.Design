---
interface Props {
  title: string;
  description: string;
  features: string[];
  icon: string;
  color: string;
  id: string;
  expanded?: boolean;
}

const {
  title,
  description,
  features,
  icon,
  color,
  id,
  expanded = false
} = Astro.props;

function getServiceIcon(icon: string) {
  const icons: Record<string, string> = {
    brand: 'M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5',
    product: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z',
    code: 'M10 18a4 4 0 0 0 4-4 4 4 0 0 0-4-4 4 4 0 0 0-4 4 4 4 0 0 0 4 4zM14 2a4 4 0 0 1 0 8 4 4 0 0 1 0-8z',
    motion: 'M8 12a4 4 0 1 0 8 0 4 4 0 0 0-8 0zM20 12a4 4 0 1 0-8 0 4 4 0 0 0 8 0zM4 12a4 4 0 1 0 8 0 4 4 0 0 0-8 0z',
    system: 'M6 6h12v12H6zM10 10h4v4h-4zM16 16H8v-4h8z',
    illustration: 'M21 12V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7M3 3v18h18'
  };
  return icons[icon] || icons.brand;
}
---

<article class="card card--glass" id={id} data-service-card>
  <div class="card__content" style="padding: var(--space-8);">
    <div style="width: 56px; height: 56px; background: var(--gradient-1); border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-6); color: var(--color-text-inverse);">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d={getServiceIcon(icon)} />
      </svg>
    </div>

    <h3 style="font-size: var(--text-2xl); font-weight: var(--font-bold); margin-bottom: var(--space-3);">{title}</h3>
    <p style="color: var(--color-text-muted); margin-bottom: var(--space-6); line-height: var(--leading-relaxed);">{description}</p>

    <ul style="list-style: none; display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3);">
      {features.map(feature => (
        <li style="display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); color: var(--color-text);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-primary); flex-shrink: 0;" aria-hidden="true">
            <path d="M20 6L9 17l-5-5"></path>
          </svg>
          {feature}
        </li>
      ))}
    </ul>
  </div>
</article>