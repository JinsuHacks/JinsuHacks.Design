---
import navData from '@/data/navigation.json';
import contactData from '@/data/contact.json';
---

<footer class="site-footer" role="contentinfo">
  <div class="site-footer-inner container">
    <div class="site-footer-grid">
      <div class="footer-brand">
        <a href="/" class="footer-logo site-logo" aria-label="JinsuHacks.Design - Home">
          <span class="site-logo-mark" aria-hidden="true">{navData.logo.mark}</span>
          <span>{navData.logo.text}</span>
        </a>
        <p class="footer-tagline">
          Brand identity, digital products and websites—designed with care for the system and the details people actually use.
        </p>
      </div>

      <nav class="footer-nav" aria-label="Services">
        <h3 class="footer-heading">Services</h3>
        <ul class="footer-links">
          <li><a href="/services#brand-identity" class="footer-link">Brand Identity</a></li>
          <li><a href="/services#digital-product" class="footer-link">Digital Product Design</a></li>
          <li><a href="/services#web-development" class="footer-link">Web Development</a></li>
          <li><a href="/services#motion-design" class="footer-link">Motion & Interaction</a></li>
          <li><a href="/services#design-systems" class="footer-link">Design Systems</a></li>
          <li><a href="/services#illustration" class="footer-link">Custom Illustration</a></li>
        </ul>
      </nav>

      <nav class="footer-nav" aria-label="Company">
        <h3 class="footer-heading">Company</h3>
        <ul class="footer-links">
          <li><a href="/portfolio" class="footer-link">Capabilities</a></li>
          <li><a href="/about" class="footer-link">About Us</a></li>
          <li><a href="/contact" class="footer-link">Contact</a></li>
        </ul>
      </nav>

      <div class="footer-contact">
        <h3 class="footer-heading">Connect</h3>
        <ul class="footer-links">
          <li>
            <a href={`mailto:${contactData.email}`} class="footer-link">
              {contactData.email}
            </a>
          </li>
          <li>
            <a href={`tel:${contactData.phoneHref}`} class="footer-link">
              {contactData.phoneDisplay}
            </a>
          </li>
          <li>
            <address class="footer-link not-italic">
              {contactData.location}
            </address>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copyright">
        &copy; {new Date().getFullYear()} JinsuHacks.Design. All rights reserved.
      </p>
      <div class="footer-social">
        <a href="https://twitter.com/jinsuhacks" class="footer-social-link" aria-label="Twitter" target="_blank" rel="noopener noreferrer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-6.706 11.55 2.832 8.4 2.848-7.258 7.84-4.204-7.388-4.186L24 2.25h-3.392l-4.85 5.57-4.424-2.485-4.328 6.104h-2.833l2.793-7.494-6.623-2.25h-2.979l4.566 6.488-6.042 7.227H.41l7.595-10.064L0 2.25h3.353l4.277 5.222 6.476-5.872H17.2l-4.72 5.208L20.033 24H24l-5.788-8.621Z"/>
          </svg>
        </a>
        <a href="https://linkedin.com/company/jinsuhacks" class="footer-social-link" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <a href="https://dribbble.com/jinsuhacks" class="footer-social-link" aria-label="Dribbble" target="_blank" rel="noopener noreferrer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.094 17.067c0 2.594-1.771 4.184-5.094 4.184-3.324 0-5.094-1.59-5.094-4.184 0-2.595 1.771-4.185 5.094-4.185 3.323 0 5.094 1.59 5.094 4.185zm-8.386-.001c0 2.332 1.569 3.766 4.49 3.766 2.92 0 4.491-1.433 4.491-3.766 0-2.333-1.571-3.767-4.491-3.767-2.921 0-4.49-1.433-4.49-3.767z"/>
          </svg>
        </a>
        <a href="https://github.com/jinsuhacks" class="footer-social-link" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg-dark);
    color: var(--color-text-inverse);
    padding: var(--space-16) 0 var(--space-8);
  }

  .site-footer-inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--section-padding-x);
  }

  .site-footer-grid {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: var(--space-12);
    margin-bottom: var(--space-12);
  }

  @media (max-width: 1024px) {
    .site-footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .site-footer-grid {
      grid-template-columns: 1fr;
    }
  }

  .footer-brand {
    max-width: 280px;
  }

  .footer-logo {
    margin-bottom: var(--space-4);
  }

  .footer-tagline {
    color: var(--metro-gray-400);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  .footer-heading {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--metro-gray-300);
    margin-bottom: var(--space-4);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-link {
    color: var(--metro-gray-400);
    font-size: var(--text-sm);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer-link:hover {
    color: var(--color-primary);
  }

  .footer-bottom {
    padding-top: var(--space-8);
    border-top: 1px solid var(--metro-gray-800);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-copyright {
    font-size: var(--text-sm);
    color: var(--metro-gray-500);
  }

  .footer-social {
    display: flex;
    gap: var(--space-4);
  }

  .footer-social-link {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background: var(--metro-gray-800);
    color: var(--metro-gray-400);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .footer-social-link:hover {
    background: var(--color-primary);
    color: var(--color-text-inverse);
    transform: translateY(-2px);
  }
</style>