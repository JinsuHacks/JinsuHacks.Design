---
interface Props {
  type?: 'circle' | 'square' | 'diamond' | 'blob' | 'pill';
  color?: 'teal' | 'orange' | 'purple' | 'cyan' | 'lime' | 'magenta' | 'teal-solid' | 'orange-solid' | 'purple-solid' | 'yellow-solid' | 'magenta-solid' | 'cyan-solid' | 'lime-solid';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  animation?: 'float' | 'float-slow' | 'float-organic' | 'drift' | 'spin' | 'pulse' | 'breathe';
  style?: Record<string, string>;
  class?: string;
}

const {
  type = 'circle',
  color = 'teal',
  size = 'md',
  animation = 'float-organic',
  style = {},
  class: className = ''
} = Astro.props;

const classes = `geo-shape geo-shape--${type} geo-shape--${color} geo-shape--${size} geo-shape--${animation} ${className}`.trim();

const inlineStyle = {
  ...style,
  '--shape-size': `var(--shape-size-${size})`,
  '--shape-bg': `var(--gradient-${color.includes('solid') ? '' : color === 'teal' ? '1' : color === 'orange' ? '2' : color === 'purple' ? '3' : color === 'cyan' ? '4' : color === 'lime' ? '5' : '6'})`,
} as Record<string, string>;
---

<div
  class={classes}
  style={inlineStyle}
  aria-hidden="true"
  data-geo-shape
></div>