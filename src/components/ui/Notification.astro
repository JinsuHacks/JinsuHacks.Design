<aside class="pf-toast" role="status" aria-label="Studio note">
  <span class="pf-toast__ribbon" aria-hidden="true"></span>
  <span class="pf-toast__badge" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3v18M3 12h18" />
    </svg>
  </span>
  <div class="pf-toast__body">
    <div class="pf-toast__head">
      <span class="pf-toast__title">A note from the studio</span>
      <span class="pf-tip">
        <button class="pf-tip__trigger" type="button" aria-label="About our design process" aria-describedby="pf-tip-bubble" aria-expanded="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <path d="M12 8h.01M11 12h1v4h1" />
          </svg>
        </button>
        <span class="pf-tip__bubble" id="pf-tip-bubble" role="tooltip">
          <span class="pf-tip__row">
            <span class="pf-tip__tag">DESIGN</span>
            <span class="pf-tip__time">DETAILS</span>
          </span>
          <span class="pf-tip__text">We start with the user flow and constraints, then refine the visual system around them.</span>
          <span class="pf-tip__arrow" aria-hidden="true"></span>
        </span>
      </span>
    </div>
    <div class="pf-toast__meta">Brand, product and web design—planned around the people who use it.</div>
  </div>
  <button class="pf-toast__close" type="button" aria-label="Dismiss studio note">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M18 6 6 18" />
      <path d="m6 6 12 12" />
    </svg>
  </button>
</aside>

<script>
  document.querySelectorAll('.pf-toast__close').forEach(button => {
    button.addEventListener('click', () => {
      button.closest('.pf-toast')?.classList.add('pf-toast--dismissed');
    });
  });

  document.querySelectorAll('.pf-tip__trigger').forEach(button => {
    const tip = button.closest('.pf-tip');

    button.addEventListener('click', () => {
      const isOpen = tip?.classList.toggle('pf-tip--open') ?? false;
      const bubble = tip?.querySelector('.pf-tip__bubble');
      button.setAttribute('aria-expanded', String(isOpen));
      if (bubble instanceof HTMLElement) {
        bubble.style.visibility = isOpen ? 'visible' : '';
        bubble.style.opacity = isOpen ? '1' : '';
        bubble.style.transform = isOpen ? 'translateY(0)' : '';
      }
    });

    button.addEventListener('keydown', event => {
      if (event.key === 'Escape') {
        tip?.classList.remove('pf-tip--open');
        const bubble = tip?.querySelector('.pf-tip__bubble');
        button.setAttribute('aria-expanded', 'false');
        if (bubble instanceof HTMLElement) {
          bubble.style.visibility = '';
          bubble.style.opacity = '';
          bubble.style.transform = '';
        }
        button.blur();
      }
    });
  });

  document.addEventListener('click', event => {
    if (event.target instanceof Element && !event.target.closest('.pf-tip')) {
      document.querySelectorAll('.pf-tip--open').forEach(tip => {
        tip.classList.remove('pf-tip--open');
        tip.querySelector('.pf-tip__trigger')?.setAttribute('aria-expanded', 'false');
        const bubble = tip.querySelector('.pf-tip__bubble');
        if (bubble instanceof HTMLElement) {
          bubble.style.visibility = '';
          bubble.style.opacity = '';
          bubble.style.transform = '';
        }
      });
    }
  });
</script>

<style>
  .pf-toast {
    --pf-canvas: #fff;
    --pf-soft: #faf9f6;
    --pf-ink: #171717;
    --pf-graphite: #525252;
    --pf-mute: #737373;
    --pf-hairline: #e5e5e5;
    --pf-lime: #a3e635;
    --pf-lime-edge: #84cc16;
    --pf-lime-ink: #17220b;
    --pf-magenta: #ec4899;
    --pf-violet: #a855f7;
    --pf-cyan: #06b6d4;
    --pf-teal: #00d4aa;
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: var(--z-toast);
    display: flex;
    align-items: flex-start;
    gap: 12px;
    width: min(360px, calc(100vw - 2rem));
    padding: 16px 14px 14px;
    overflow: visible;
    border: 1px solid var(--pf-hairline);
    border-radius: 12px;
    background: var(--pf-canvas);
    box-shadow: 0 12px 32px -16px rgba(11, 11, 15, .35), 0 4px 14px rgba(11, 11, 15, .08);
    animation: pf-toast-in 420ms cubic-bezier(.2, .8, .2, 1) both;
  }

  .pf-toast--dismissed {
    pointer-events: none;
    animation: pf-toast-out 220ms ease-in forwards;
  }

  .pf-toast__ribbon {
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    border-radius: 12px 12px 0 0;
    background: linear-gradient(90deg, var(--pf-magenta), var(--pf-violet), var(--pf-cyan), var(--pf-teal), var(--pf-lime));
  }

  .pf-toast__badge {
    flex: none;
    display: inline-grid;
    width: 32px;
    height: 32px;
    place-items: center;
    border: 1px solid var(--pf-lime-edge);
    border-radius: 8px;
    background: var(--pf-lime);
    color: var(--pf-lime-ink);
    box-shadow: 0 6px 14px -8px rgba(124, 226, 91, .6);
  }

  .pf-toast__badge svg { width: 16px; height: 16px; }
  .pf-toast__body { flex: 1; display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .pf-toast__head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .pf-toast__title { color: var(--pf-ink); font-size: 15px; font-weight: 700; letter-spacing: -.01em; line-height: 1.25; }
  .pf-toast__tag { padding: 2px 6px; border: 1px solid var(--pf-hairline); border-radius: 4px; background: var(--pf-soft); color: var(--pf-ink); font-family: var(--font-mono); font-size: 10px; letter-spacing: .12em; line-height: 1.3; }
  .pf-toast__meta { color: var(--pf-graphite); font-size: 12px; line-height: 1.45; }

  .pf-tip { position: relative; display: inline-flex; }
  .pf-tip__trigger {
    display: inline-grid;
    width: 22px;
    height: 22px;
    place-items: center;
    border: 1px solid var(--pf-hairline);
    border-radius: 50%;
    background: var(--pf-soft);
    color: var(--pf-graphite);
    cursor: help;
    transition: color 120ms ease-out, border-color 120ms ease-out, background 120ms ease-out;
  }
  .pf-tip__trigger svg { width: 13px; height: 13px; }
  .pf-tip__trigger:hover, .pf-tip__trigger:focus-visible { border-color: var(--pf-cyan); background: #fff; color: var(--pf-ink); }
  .pf-tip__trigger:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(63, 199, 232, .32); }
  .pf-tip__bubble {
    position: absolute;
    right: -8px;
    bottom: calc(100% + 13px);
    z-index: 1;
    width: min(250px, calc(100vw - 48px));
    padding: 12px 14px;
    border: 1px solid transparent;
    border-radius: 9px;
    background: linear-gradient(#171717, #171717) padding-box, linear-gradient(90deg, var(--pf-magenta), var(--pf-violet), var(--pf-cyan), var(--pf-teal), var(--pf-lime)) border-box;
    box-shadow: 0 12px 32px -16px rgba(11, 11, 15, .5);
    color: #fff;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(4px);
    transition: opacity 180ms ease-out, transform 220ms ease-out, visibility 180ms;
  }
  .pf-tip:hover .pf-tip__bubble, .pf-tip:focus-within .pf-tip__bubble, .pf-tip--open .pf-tip__bubble { opacity: 1; visibility: visible; pointer-events: auto; transform: translateY(0); }
  .pf-tip__row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
  .pf-tip__tag { padding: 3px 6px; border-radius: 3px; background: rgba(163, 230, 53, .13); color: #bef264; font-family: var(--font-mono); font-size: 10px; font-weight: 700; letter-spacing: .12em; line-height: 1; }
  .pf-tip__time { color: #a3a3a3; font-family: var(--font-mono); font-size: 9px; letter-spacing: .1em; }
  .pf-tip__text { display: block; color: #fff; font-size: 12px; font-weight: 400; line-height: 1.5; }
  .pf-tip__arrow { position: absolute; right: 12px; bottom: -5px; width: 9px; height: 9px; transform: rotate(45deg); border-right: 1px solid var(--pf-violet); border-bottom: 1px solid var(--pf-violet); background: #171717; }

  .pf-toast__close {
    flex: none;
    display: inline-grid;
    width: 28px;
    height: 28px;
    place-items: center;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--pf-mute);
    cursor: pointer;
    transition: background 120ms ease-out, color 120ms ease-out;
  }

  .pf-toast__close svg { width: 14px; height: 14px; }
  .pf-toast__close:hover { background: var(--pf-soft); color: var(--pf-ink); }
  .pf-toast__close:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(63, 199, 232, .36); }

  @keyframes pf-toast-in {
    from { opacity: 0; transform: translateY(12px) scale(.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  @keyframes pf-toast-out {
    to { opacity: 0; transform: translateY(8px) scale(.98); }
  }

  @media (max-width: 480px) {
    .pf-toast { right: 12px; bottom: 12px; width: calc(100vw - 24px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pf-toast, .pf-toast--dismissed { animation-duration: .01ms; }
  }
</style>
