---
interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
  ogImage?: string;
  noIndex?: boolean;
}

import '../styles/tokens.css';
import '../styles/globals.css';
import '../styles/animations.css';
import '../styles/frutiger-metro.css';
import '../styles/components.css';
import Notification from '@/components/ui/Notification.astro';

const {
  title,
  description = "JinsuHacks.Design - B2B Design Studio crafting digital products, brands, and experiences with Frutiger Metro aesthetic.",
  canonicalURL,
  ogImage = "/og-default.jpg",
  noIndex = false
} = Astro.props;

const siteUrl = "https://jinsuhacks.design";
const pageUrl = canonicalURL ? new URL(canonicalURL, siteUrl).href : Astro.url.href;
const pageTitle = `${title} | JinsuHacks.Design`;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).href} />
    <meta property="og:site_name" content="JinsuHacks.Design" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteUrl).href} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- Critical CSS inlined -->
    <style is:inline>
      {`*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}html{font-size:16px;scroll-behavior:smooth}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}body{font-family:"DM Sans",system-ui,sans-serif;font-size:clamp(0.95rem,0.875rem+0.375vw,1rem);line-height:1.5;color:#171717;background:#FAFAFA;-webkit-font-smoothing:antialiased}img,video,canvas,svg{display:block;max-width:100%;height:auto}:focus-visible{outline:2px solid #00D4AA;outline-offset:2px}.skip-link{position:absolute;top:-100%;left:1rem;padding:0.5rem 1rem;background:#00D4AA;color:#FAFAFA;border-radius:0.5rem;z-index:600;transition:top 150ms ease-out}.skip-link:focus{top:1rem}`}
    </style>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <slot name="header" />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <slot name="footer" />
    <Notification />

    <!-- View Transitions -->
    <script is:inline>
      if (document.startViewTransition) {
        document.addEventListener('astro:before-swap', () => {
          document.documentElement.style.setProperty('--astro-transition', 'true');
        });
      }
    </script>

    <!-- Global Scripts -->
    <script src="../scripts/main.js"></script>
  </body>
</html>